# Copy to .env.local for local dev (Vite loads .env.local automatically,
# gitignored by create-vite's default .gitignore). On Vercel, set
# VITE_API_BASE_URL as a project environment variable instead - there is no
# Docker here, this app deploys to Vercel as a static build.
VITE_API_BASE_URL=http://localhost:8080
